# === Required ===
# Firecrawl API key — get from https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-YOUR_KEY_HERE

# Anthropic API key — get from https://console.anthropic.com/settings/keys
# Required for Tier 3 vision fallback (used when Firecrawl can't render
# JS-heavy pages like Albatros and Stjernegaard's priser-og-datoer).
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Supabase Postgres connection string (Transaction Pooler URL).
# Find den under Project Settings → Database på
# https://supabase.com/dashboard/project/bymurhqfcyxdhrayddoz
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# === Optional ===
# Supabase REST-adgang (bruges af enkelte scripts, ikke af app'en)
# SUPABASE_URL=https://bymurhqfcyxdhrayddoz.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...

# Password-gate til Streamlit-appen. Udelad lokalt for at springe login over
# (på Streamlit Cloud er den PÅKRÆVET og sættes i appens secrets).
# APP_PASSWORD=vælg-et-password
